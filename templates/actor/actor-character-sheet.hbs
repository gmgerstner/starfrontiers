<form class="{{cssClass}} flexcol" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="100" width="100"/>
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="Character Name"/></h1>

      <div class="header-meta">
        <div class="meta-field race-field">
          <label>Race</label>
          {{#if race}}
            <div class="race-slot item" data-item-id="{{race._id}}">
              <img src="{{race.img}}" title="{{race.name}}" width="22" height="22"/>
              <span class="race-name">{{race.name}}</span>
              <a class="item-control item-edit" title="Edit Race"><i class="fas fa-edit"></i></a>
              <a class="item-control item-delete" title="Remove Race"><i class="fas fa-trash"></i></a>
            </div>
          {{else}}
            <span class="race-empty" title="Drag a Race item onto the sheet"><i class="fas fa-hand-pointer"></i> Drag a race here</span>
          {{/if}}
        </div>
        <div class="meta-field">
          <label>XP</label>
          <input type="number" step="1" min="0" name="system.experience" value="{{system.experience}}" data-dtype="Number"/>
        </div>
        <div class="meta-field">
          <label>Credits</label>
          <input type="number" step="1" min="0" name="system.credits" value="{{system.credits}}" data-dtype="Number"/>
        </div>
      </div>

      <div class="header-actions">
        <button type="button" class="roll-initial-stats small" title="Roll d100 for each ability to generate initial base scores" {{#if flags.starfrontiers.statsLocked}}disabled{{/if}}><i class="fas fa-dice-d10"></i> Roll Initial Stats</button>
        <button type="button" class="toggle-stats-lock small" title="Lock stats to prevent editing or accidental rolls" {{#unless owner}}disabled{{/unless}}><i class="fas {{#if flags.starfrontiers.statsLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i> {{#if flags.starfrontiers.statsLocked}}Unlock{{else}}Lock{{/if}} Stats</button>
      </div>
    </div>
  </header>

  <section class="ability-block">
    <h3 class="block-title">Ability Scores</h3>
    <div class="ability-grid">

      <div class="ability-pair">
        <div class="score">
          <span class="score-abbr">STR</span>
          <input class="score-value" type="number" step="1" min="1" max="100" name="system.str.value" value="{{system.str.value}}" data-dtype="Number" {{#if flags.starfrontiers.statsLocked}}disabled{{/if}}/>
          <span class="score-mod">{{#if system.str.racial}}<span class="racial-badge" title="Racial modifier">{{sfSigned system.str.racial}}</span> <span class="score-total" title="Effective score">{{system.str.total}}</span>{{/if}}</span>
        </div>
        <div class="score">
          <span class="score-abbr">STA</span>
          <input class="score-value sta-max" type="number" step="1" min="1" max="100" name="system.stamina.value" value="{{system.stamina.value}}" data-dtype="Number" title="Maximum Stamina" {{#if flags.starfrontiers.statsLocked}}disabled{{/if}}/>
          <span class="score-mod">max</span>
        </div>
      </div>

      <div class="ability-pair">
        <div class="score">
          <span class="score-abbr">DEX</span>
          <input class="score-value" type="number" step="1" min="1" max="100" name="system.dex.value" value="{{system.dex.value}}" data-dtype="Number" {{#if flags.starfrontiers.statsLocked}}disabled{{/if}}/>
          <span class="score-mod">{{#if system.dex.racial}}<span class="racial-badge" title="Racial modifier">{{sfSigned system.dex.racial}}</span> <span class="score-total" title="Effective score">{{system.dex.total}}</span>{{/if}}</span>
        </div>
        <div class="score">
          <span class="score-abbr">RS</span>
          <input class="score-value rs-input" type="number" step="1" min="1" max="100" name="system.rs" value="{{system.rs}}" data-dtype="Number" title="Reaction Speed. Editing RS changes IM." {{#if flags.starfrontiers.statsLocked}}disabled{{/if}}/>
          <span class="score-mod">IM {{system.im}}</span>
        </div>
      </div>

      <div class="ability-pair">
        <div class="score">
          <span class="score-abbr">INT</span>
          <input class="score-value" type="number" step="1" min="1" max="100" name="system.int.value" value="{{system.int.value}}" data-dtype="Number" {{#if flags.starfrontiers.statsLocked}}disabled{{/if}}/>
          <span class="score-mod">{{#if system.int.racial}}<span class="racial-badge" title="Racial modifier">{{sfSigned system.int.racial}}</span> <span class="score-total" title="Effective score">{{system.int.total}}</span>{{/if}}</span>
        </div>
        <div class="score">
          <span class="score-abbr">LOG</span>
          <input class="score-value" type="number" step="1" min="1" max="100" name="system.log.value" value="{{system.log.value}}" data-dtype="Number" {{#if flags.starfrontiers.statsLocked}}disabled{{/if}}/>
          <span class="score-mod">{{#if system.log.racial}}<span class="racial-badge" title="Racial modifier">{{sfSigned system.log.racial}}</span> <span class="score-total" title="Effective score">{{system.log.total}}</span>{{/if}}</span>
        </div>
      </div>

      <div class="ability-pair">
        <div class="score">
          <span class="score-abbr">PER</span>
          <input class="score-value" type="number" step="1" min="1" max="100" name="system.per.value" value="{{system.per.value}}" data-dtype="Number" {{#if flags.starfrontiers.statsLocked}}disabled{{/if}}/>
          <span class="score-mod">{{#if system.per.racial}}<span class="racial-badge" title="Racial modifier">{{sfSigned system.per.racial}}</span> <span class="score-total" title="Effective score">{{system.per.total}}</span>{{/if}}</span>
        </div>
        <div class="score">
          <span class="score-abbr">LDR</span>
          <input class="score-value" type="number" step="1" min="1" max="100" name="system.ldr.value" value="{{system.ldr.value}}" data-dtype="Number" {{#if flags.starfrontiers.statsLocked}}disabled{{/if}}/>
          <span class="score-mod">{{#if system.ldr.racial}}<span class="racial-badge" title="Racial modifier">{{sfSigned system.ldr.racial}}</span> <span class="score-total" title="Effective score">{{system.ldr.total}}</span>{{/if}}</span>
        </div>
      </div>

    </div>

    <div class="vitals-bar">
      <div class="vital">
        <span class="vital-label">Current STA</span>
        <input class="sta-current" type="number" step="1" min="0" max="100" name="system.stamina.current" value="{{system.stamina.current}}" data-dtype="Number" title="Current Stamina (track damage here)."/>
      </div>
      <div class="vital">
        <span class="vital-label">Max STA</span>
        <input class="vital-readonly" type="number" value="{{system.stamina.value}}" readonly aria-readonly="true"/>
      </div>
      <div class="vital">
        <span class="vital-label">Init. Modifier</span>
        <input class="im-display vital-readonly" type="number" value="{{system.im}}" readonly aria-readonly="true"/>
      </div>
      <div class="vital">
        <span class="vital-label">Defense</span>
        <input class="vital-readonly" type="number" value="{{totalDefense}}" readonly aria-readonly="true" title="Total defense from equipped armor"/>
      </div>
    </div>
  </section>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="skills"><i class="fas fa-graduation-cap"></i> Skills</a>
    <a class="item" data-tab="gear"><i class="fas fa-box-open"></i> Gear</a>
    <a class="item" data-tab="bio"><i class="fas fa-book"></i> Biography</a>
  </nav>

  <section class="sheet-body">
    <div class="tab skills" data-group="primary" data-tab="skills">
      <div class="items-section">
        <header class="section-header">
          <h3>Skills</h3>
          <a class="item-control item-create" data-type="skill" title="Add Skill"><i class="fas fa-plus"></i></a>
        </header>
        <ol class="items-list">
          <li class="item item-head flexrow">
            <span class="item-name">Name</span>
            <span class="item-detail">Level</span>
            <span class="item-controls-head">&nbsp;</span>
          </li>
          {{#each skills as |item id|}}
            <li class="item flexrow" data-item-id="{{item._id}}">
              <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
              <h4 class="item-name">{{item.name}}</h4>
              <span class="item-detail">{{item.system.level}}</span>
              <div class="item-controls">
                <a class="item-control item-roll" title="Roll Skill"><i class="fas fa-dice-d20"></i></a>
                <a class="item-control item-edit" title="Edit Skill"><i class="fas fa-edit"></i></a>
                <a class="item-control item-delete" title="Delete Skill"><i class="fas fa-trash"></i></a>
              </div>
            </li>
          {{/each}}
        </ol>
      </div>
    </div>

    <div class="tab gear" data-group="primary" data-tab="gear">
      <div class="items-section">
        <header class="section-header">
          <h3>Weapons</h3>
          <a class="item-control item-create" data-type="weapon" title="Add Weapon"><i class="fas fa-plus"></i></a>
        </header>
        <ol class="items-list">
          <li class="item item-head flexrow">
            <span class="item-name">Name</span>
            <span class="item-detail">Dmg</span>
            <span class="item-detail">Rng</span>
            <span class="item-detail">Ammo</span>
            <span class="item-controls-head">&nbsp;</span>
          </li>
          {{#each weapons as |item id|}}
            <li class="item flexrow" data-item-id="{{item._id}}">
              <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
              <h4 class="item-name">{{item.name}}</h4>
              <span class="item-detail item-damage">{{item.system.damage}}</span>
              <span class="item-detail">{{item.system.range}}</span>
              <span class="item-detail">{{#if item.system.ammoMax}}{{item.system.ammo}}/{{item.system.ammoMax}}{{else}}&mdash;{{/if}}</span>
              <div class="item-controls">
                <a class="item-control item-roll" title="Attack (to-hit + damage)"><i class="fas fa-crosshairs"></i></a>
                <a class="item-control item-edit" title="Edit Weapon"><i class="fas fa-edit"></i></a>
                <a class="item-control item-delete" title="Delete Weapon"><i class="fas fa-trash"></i></a>
              </div>
            </li>
          {{/each}}
        </ol>

        <header class="section-header">
          <h3>Defenses</h3>
          <a class="item-control item-create" data-type="armor" title="Add Armor"><i class="fas fa-plus"></i></a>
        </header>
        <ol class="items-list">
          <li class="item item-head flexrow">
            <span class="item-name">Name</span>
            <span class="item-detail">Type</span>
            <span class="item-detail">Def</span>
            <span class="item-controls-head">&nbsp;</span>
          </li>
          {{#each armor as |item id|}}
            <li class="item flexrow {{#if item.system.equipped}}equipped{{/if}}" data-item-id="{{item._id}}">
              <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
              <h4 class="item-name">{{item.name}}</h4>
              <span class="item-detail">{{item.system.type}}</span>
              <span class="item-detail">{{item.system.defense}}</span>
              <div class="item-controls">
                <a class="item-control armor-equip-toggle {{#if item.system.equipped}}active{{/if}}" title="Toggle Equipped"><i class="fas fa-shield-alt"></i></a>
                <a class="item-control item-edit" title="Edit Armor"><i class="fas fa-edit"></i></a>
                <a class="item-control item-delete" title="Delete Armor"><i class="fas fa-trash"></i></a>
              </div>
            </li>
          {{/each}}
        </ol>

        <header class="section-header">
          <h3>Equipment</h3>
          <a class="item-control item-create" data-type="equipment" title="Add Equipment"><i class="fas fa-plus"></i></a>
        </header>
        <ol class="items-list">
          <li class="item item-head flexrow">
            <span class="item-name">Name</span>
            <span class="item-detail">Qty</span>
            <span class="item-controls-head">&nbsp;</span>
          </li>
          {{#each equipment as |item id|}}
            <li class="item flexrow" data-item-id="{{item._id}}">
              <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
              <h4 class="item-name">{{item.name}}</h4>
              <span class="item-detail">{{item.system.quantity}}</span>
              <div class="item-controls">
                <a class="item-control item-edit" title="Edit Equipment"><i class="fas fa-edit"></i></a>
                <a class="item-control item-delete" title="Delete Equipment"><i class="fas fa-trash"></i></a>
              </div>
            </li>
          {{/each}}
        </ol>
      </div>
    </div>

    <div class="tab biography" data-group="primary" data-tab="bio">
      <div class="editor">
        {{editor system.biography target="system.biography" button=true owner=owner editable=editable}}
      </div>
    </div>
  </section>
</form>
