{
  "id": "starfrontiers",
  "title": "Star Frontiers",
  "description": "A game system for playing Star Frontiers in Foundry VTT",
  "version": "1.0.19",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "authors": [
    {
      "name": "G.M.Gerstner"
    }
  ],
  "esmodules": [
    "module/starfrontiers.mjs"
  ],
  "documentTypes": {
    "Actor": {
      "character": {},
      "npc": {}
    },
    "Item": {
      "weapon": {},
      "armor": {},
      "equipment": {},
      "skill": {},
      "race": {}
    }
  },
  "styles": [
    "styles/starfrontiers.css"
  ],
  "packs": [
    {
      "name": "races",
      "label": "Races",
      "path": "packs/races",
