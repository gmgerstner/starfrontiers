      "system": "starfrontiers",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "skills",
      "label": "Skills",
      "path": "packs/skills",
      "type": "Item",
      "system": "starfrontiers",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "packFolders": [
    {
      "name": "Star Frontiers",
      "sorting": "m",
      "packs": ["races", "skills"]
    }
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "grid": {
    "distance": 1.5,
    "units": "m"
  },
  "primaryTokenAttribute": "stamina",
  "secondaryTokenAttribute": "stamina",
  "url": "https://github.com/gmgerstner/starfrontiers",
  "manifest": "https://github.com/gmgerstner/starfrontiers/releases/latest/download/system.json",
